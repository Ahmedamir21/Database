# ---------------------------------------------------------------------------------------
# Zewail Desk - the environment of the client
#
# Locally:  copy this file to client/.env (it is git-ignored) if you need to change anything.
# On Vercel: these are Build-time variables of the client project (see docs/DEPLOYMENT.md).
# They are all public by nature: everything starting with VITE_ ends up in the JavaScript
# that the browser downloads, so no password and no secret may ever be written here.
# ---------------------------------------------------------------------------------------

# real = talk to the Express API (the delivered application)
# mock = answer from src/mock/handlers.js, for a demonstration without SQL Server
VITE_API_MODE=real

# empty = the API is on the same origin as the pages (one deployment, the normal case).
# Set it to the address of the API deployment when the client has its own domain:
# VITE_API_BASE_URL=https://database-ahmedamir21.vercel.app
VITE_API_BASE_URL=

# only used by "npm run dev": where the Vite development server proxies /api to
VITE_API_TARGET=http://localhost:4000
