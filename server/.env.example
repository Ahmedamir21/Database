# ---------------------------------------------------------------------------------------
# Zewail Desk - the environment of the API
#
# Locally:   copy this file to server/.env and fill in the values of your SQL Server.
#            server/.env is in .gitignore: no password of this project is ever committed.
# On Vercel: every name below is a Project Setting -> Environment Variable (see
#            docs/DEPLOYMENT.md). No value of this file is a real credential.
# ---------------------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# --- SQL Server -------------------------------------------------------------------------
# All four are required: when one is missing the API answers 503 database_not_configured
# and names it, instead of guessing "sa@localhost".
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=ZewailDesk
DB_USER=sa
DB_PASSWORD=change-me
# a local SQL Server with a self signed certificate:
DB_ENCRYPT=false
DB_TRUST_CERT=true
# a deployment: DB_ENCRYPT=true, and DB_TRUST_CERT=false when the server has a real
# certificate (Azure SQL and every public SQL Server endpoint do)
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT=15000
DB_REQUEST_TIMEOUT=20000
# 0 = off. On a serverless platform a value in seconds (e.g. 30) keeps the pool warm, at the
# price of one function call per interval.
DB_KEEP_ALIVE_SECONDS=0

# --- sessions ---------------------------------------------------------------------------
# a long random string (32 characters or more); the JWT of every visitor is signed with it.
# In production a missing or example secret refuses every sign in with a clear message:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_MINUTES=480
COOKIE_NAME=zewaildesk_session
# lax  = the pages and the API are on the same site (the default, and what one server needs)
# none = the client is deployed separately; requires https, which production always is
COOKIE_SAMESITE=lax
# only needed to share the cookie between sub-domains of one domain
# COOKIE_DOMAIN=.example.edu.eg
BCRYPT_ROUNDS=10

# --- the client -------------------------------------------------------------------------
# every browser address that may call this API with a cookie, comma separated. The
# deployment's own addresses are always allowed and never have to be listed here. No
# wildcard: the session travels in a cookie.
CLIENT_ORIGIN=http://localhost:5173

# --- the first administrator (only used by "npm run seed:admin") ------------------------
ADMIN_NAME=Sara Ibrahim
ADMIN_EMAIL=sara.ibrahim@zewailcity.edu.eg
ADMIN_PASSWORD=Desk#2025
ADMIN_POSITION=Head of Student Records

# --- sample data -------------------------------------------------------------------------
# the password of the sample accounts of database/02_seed.sql (shown on the sign in page)
DEMO_PASSWORD=Desk#2025
