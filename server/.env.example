# ---------------------------------------------------------------------------------------
# Zewail Desk - the environment of the API
# Copy this file to server/.env and fill in the values of your SQL Server.
# server/.env is in .gitignore: no password of this project is ever committed.
# ---------------------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# --- SQL Server -------------------------------------------------------------------------
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=ZewailDesk
DB_USER=sa
DB_PASSWORD=change-me
# local SQL Server with a self signed certificate:
DB_ENCRYPT=false
DB_TRUST_CERT=true
DB_POOL_MAX=10

# --- sessions ---------------------------------------------------------------------------
# a long random string; the JWT of every visitor is signed with it
JWT_SECRET=change-me-to-a-long-random-string
JWT_MINUTES=480

# --- the client -------------------------------------------------------------------------
# the Vite development server; the built client is served by this same port and needs nothing
CLIENT_ORIGIN=http://localhost:5173

# --- the first administrator (only used by "npm run seed:admin") ------------------------
ADMIN_NAME=Sara Ibrahim
ADMIN_EMAIL=sara.ibrahim@zewailcity.edu.eg
ADMIN_PASSWORD=Desk#2025
ADMIN_POSITION=Head of Student Records

# --- demonstration -----------------------------------------------------------------------
# the password of the sample accounts of database/02_seed.sql (shown on the sign in page)
DEMO_PASSWORD=Desk#2025
